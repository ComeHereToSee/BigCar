# Copy to Deploy/.env and fill in. Never commit the real file.
BIGCAR_DB_PASSWORD=change-me
BIGCAR_TOKEN_SECRET=change-me-to-a-random-string-of-at-least-32-chars
BIGCAR_SERVER_KEY=change-me-server-key
BIGCAR_WEBHOOK_SECRET=
# Public IP or DNS name of this machine (what game clients connect to over UDP 7777-7779)
BIGCAR_PUBLIC_ADDRESS=203.0.113.10
BIGCAR_REGION=local
BIGCAR_HTTP_PORT=8080
# BIGCAR_BACKEND_IMAGE=ghcr.io/comeheretosee/bigcar-backend:latest
# BIGCAR_SERVER_IMAGE=ghcr.io/comeheretosee/bigcar-server:latest
